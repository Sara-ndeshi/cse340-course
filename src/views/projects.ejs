<%- include('partials/header') %>
    <main>
        <h1>Service Projects</h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', { month: 'short' , day: 'numeric'
                            , year: 'numeric' , timeZone: 'UTC' }) %>:
                    </strong>
                    <%= project.title %>
                        (<em>
                            <%= project.organization_name %>
                        </em>)
                        <p>
                            <%= project.description %> — <small>Location: <%= project.location %></small>
                        </p>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>